<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.textbook.mapper.BookNoticeMapper">

    <resultMap type="com.ruoyi.textbook.domain.BookNotice" id="BookNoticeResult">
        <result property="noticeId"    column="notice_id"    />
        <result property="noticeNo"    column="notice_no"    />
        <result property="semester"    column="semester"    />
        <result property="pickupStart" column="pickup_start" />
        <result property="pickupEnd"   column="pickup_end"   />
        <result property="pickupLocation" column="pickup_location" />
        <result property="status"      column="status"       />
        <result property="totalClasses" column="total_classes" />
        <result property="issuedClasses" column="issued_classes" />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
        <result property="delFlag"     column="del_flag"     />
    </resultMap>

    <sql id="selectBookNoticeVo">
        select notice_id, notice_no, semester, pickup_start, pickup_end, pickup_location,
               status, total_classes, issued_classes, create_by, create_time, update_by, update_time,
               remark, del_flag
        from textbook_notice
    </sql>

    <select id="selectBookNoticeById" parameterType="Long" resultMap="BookNoticeResult">
        <include refid="selectBookNoticeVo"/>
        where notice_id = #{noticeId} and del_flag = '0'
    </select>

    <select id="selectBookNoticeList" parameterType="com.ruoyi.textbook.domain.BookNotice" resultMap="BookNoticeResult">
        <include refid="selectBookNoticeVo"/>
        <where>
            del_flag = '0'
            <if test="noticeNo != null  and noticeNo != ''"> and notice_no like concat('%', #{noticeNo}, '%')</if>
            <if test="semester != null  and semester != ''"> and semester like concat('%', #{semester}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="pickupLocation != null  and pickupLocation != ''"> and pickup_location like concat('%', #{pickupLocation}, '%')</if>
        </where>
        order by create_time desc
    </select>

    <insert id="insertBookNotice" parameterType="com.ruoyi.textbook.domain.BookNotice" useGeneratedKeys="true" keyProperty="noticeId">
        insert into textbook_notice (
            <if test="noticeNo != null and noticeNo != ''">notice_no,</if>
            <if test="semester != null and semester != ''">semester,</if>
            <if test="pickupStart != null">pickup_start,</if>
            <if test="pickupEnd != null">pickup_end,</if>
            <if test="pickupLocation != null and pickupLocation != ''">pickup_location,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="totalClasses != null">total_classes,</if>
            <if test="issuedClasses != null">issued_classes,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time,
            <if test="remark != null and remark != ''">remark,</if>
            del_flag
        )values(
            <if test="noticeNo != null and noticeNo != ''">#{noticeNo},</if>
            <if test="semester != null and semester != ''">#{semester},</if>
            <if test="pickupStart != null">#{pickupStart},</if>
            <if test="pickupEnd != null">#{pickupEnd},</if>
            <if test="pickupLocation != null and pickupLocation != ''">#{pickupLocation},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="totalClasses != null">#{totalClasses},</if>
            <if test="issuedClasses != null">#{issuedClasses},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate(),
            <if test="remark != null and remark != ''">#{remark},</if>
            '0'
        )
    </insert>

    <update id="updateBookNotice" parameterType="com.ruoyi.textbook.domain.BookNotice">
        update textbook_notice
        <set>
            <if test="noticeNo != null and noticeNo != ''">notice_no = #{noticeNo},</if>
            <if test="semester != null and semester != ''">semester = #{semester},</if>
            <if test="pickupStart != null">pickup_start = #{pickupStart},</if>
            <if test="pickupEnd != null">pickup_end = #{pickupEnd},</if>
            <if test="pickupLocation != null and pickupLocation != ''">pickup_location = #{pickupLocation},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="totalClasses != null">total_classes = #{totalClasses},</if>
            <if test="issuedClasses != null">issued_classes = #{issuedClasses},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where notice_id = #{noticeId} and del_flag = '0'
    </update>

    <update id="updateNoticeStatus">
        update textbook_notice set status = #{status}, update_time = sysdate()
        where notice_id = #{noticeId} and del_flag = '0'
    </update>

    <update id="updateNoticeStatusWithExpected">
        update textbook_notice set status = #{newStatus}, update_time = sysdate()
        where notice_id = #{noticeId} and status = #{expectedStatus} and del_flag = '0'
    </update>

    <update id="updateIssuedClasses">
        update textbook_notice set issued_classes = #{issuedClasses},
            <choose>
                <when test="issuedClasses > 0 and issuedClasses &lt; total_classes">status = '2'</when>
                <when test="issuedClasses >= total_classes and total_classes > 0">status = '3'</when>
            </choose>,
            update_time = sysdate()
        where notice_id = #{noticeId} and del_flag = '0'
    </update>

    <delete id="deleteBookNoticeById" parameterType="Long">
        update textbook_notice set del_flag = '1' where notice_id = #{noticeId}
    </delete>

    <delete id="deleteBookNoticeByIds" parameterType="String">
        update textbook_notice set del_flag = '1' where notice_id in
        <foreach item="noticeId" collection="array" open="(" separator="," close=")">
            #{noticeId}
        </foreach>
    </delete>

</mapper>
