<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.textbook.mapper.TbBookMapper">
    <resultMap type="com.ruoyi.textbook.domain.TbBook" id="TbBookResult">
        <id property="bookId" column="book_id"/>
        <result property="bookName" column="book_name"/>
        <result property="isbn" column="isbn"/>
        <result property="author" column="author"/>
        <result property="publisher" column="publisher"/>
        <result property="publishDate" column="publish_date"/>
        <result property="edition" column="edition"/>
        <result property="printTimes" column="print_times"/>
        <result property="format" column="format"/>
        <result property="binding" column="binding"/>
        <result property="price" column="price"/>
        <result property="wordCount" column="word_count"/>
        <result property="pageCount" column="page_count"/>
        <result property="courseName" column="course_name"/>
        <result property="major" column="major"/>
        <result property="grade" column="grade"/>
        <result property="textbookType" column="textbook_type"/>
        <result property="category" column="category"/>
        <result property="description" column="description"/>
        <result property="coverImage" column="cover_image"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectTbBookVo">
        select book_id, book_name, isbn, author, publisher, publish_date, edition, print_times,
               format, binding, price, word_count, page_count, course_name, major, grade,
               textbook_type, category, description, cover_image, status,
               create_by, create_time, update_by, update_time, del_flag
        from textbook_info
    </sql>

    <select id="selectTbBookList" parameterType="com.ruoyi.textbook.domain.TbBook" resultMap="TbBookResult">
        <include refid="selectTbBookVo"/> where del_flag = '0'
        <if test="bookName != null and bookName != ''">and book_name like concat('%',#{bookName},'%')</if>
        <if test="isbn != null and isbn != ''">and isbn = #{isbn}</if>
        <if test="author != null and author != ''">and author like concat('%',#{author},'%')</if>
        <if test="publisher != null and publisher != ''">and publisher like concat('%',#{publisher},'%')</if>
        <if test="courseName != null and courseName != ''">and course_name like concat('%',#{courseName},'%')</if>
        <if test="major != null and major != ''">and major like concat('%',#{major},'%')</if>
        <if test="grade != null and grade != ''">and grade = #{grade}</if>
        <if test="textbookType != null and textbookType != ''">and textbook_type = #{textbookType}</if>
        <if test="category != null and category != ''">and category = #{category}</if>
        order by create_time desc
    </select>

    <select id="selectTbBookByBookId" parameterType="Long" resultMap="TbBookResult">
        <include refid="selectTbBookVo"/> where book_id = #{bookId} and del_flag = '0'
    </select>

    <insert id="insertTbBook" parameterType="com.ruoyi.textbook.domain.TbBook" useGeneratedKeys="true" keyProperty="bookId">
        insert into textbook_info(
            <trim prefix="" suffix="" suffixOverrides=",">
                <if test="bookName != null and bookName != ''">book_name,</if>
                <if test="isbn != null and isbn != ''">isbn,</if>
                <if test="author != null">author,</if>
                <if test="publisher != null">publisher,</if>
                <if test="publishDate != null">publish_date,</if>
                <if test="edition != null">edition,</if>
                <if test="printTimes != null">print_times,</if>
                <if test="format != null">format,</if>
                <if test="binding != null">binding,</if>
                <if test="price != null">price,</if>
                <if test="wordCount != null">word_count,</if>
                <if test="pageCount != null">page_count,</if>
                <if test="courseName != null">course_name,</if>
                <if test="major != null">major,</if>
                <if test="grade != null">grade,</if>
                <if test="textbookType != null">textbook_type,</if>
                <if test="category != null">category,</if>
                <if test="description != null">description,</if>
                <if test="coverImage != null">cover_image,</if>
                <if test="status != null">status,</if>
                <if test="createBy != null">create_by,</if>create_time
            </trim>
        ) values (
            <trim prefix="" suffix="" suffixOverrides=",">
                <if test="bookName != null and bookName != ''">#{bookName},</if>
                <if test="isbn != null and isbn != ''">#{isbn},</if>
                <if test="author != null">#{author},</if>
                <if test="publisher != null">#{publisher},</if>
                <if test="publishDate != null">#{publishDate},</if>
                <if test="edition != null">#{edition},</if>
                <if test="printTimes != null">#{printTimes},</if>
                <if test="format != null">#{format},</if>
                <if test="binding != null">#{binding},</if>
                <if test="price != null">#{price},</if>
                <if test="wordCount != null">#{wordCount},</if>
                <if test="pageCount != null">#{pageCount},</if>
                <if test="courseName != null">#{courseName},</if>
                <if test="major != null">#{major},</if>
                <if test="grade != null">#{grade},</if>
                <if test="textbookType != null">#{textbookType},</if>
                <if test="category != null">#{category},</if>
                <if test="description != null">#{description},</if>
                <if test="coverImage != null">#{coverImage},</if>
                <if test="status != null">#{status},</if>
                <if test="createBy != null">#{createBy},</if>sysdate()
            </trim>
        )
    </insert>

    <update id="updateTbBook" parameterType="com.ruoyi.textbook.domain.TbBook">
        update textbook_info
        <set>
            <if test="bookName != null and bookName != ''">book_name=#{bookName},</if>
            <if test="isbn != null and isbn != ''">isbn=#{isbn},</if>
            <if test="author != null">author=#{author},</if>
            <if test="publisher != null">publisher=#{publisher},</if>
            <if test="publishDate != null">publish_date=#{publishDate},</if>
            <if test="edition != null">edition=#{edition},</if>
            <if test="printTimes != null">print_times=#{printTimes},</if>
            <if test="format != null">format=#{format},</if>
            <if test="binding != null">binding=#{binding},</if>
            <if test="price != null">price=#{price},</if>
            <if test="wordCount != null">word_count=#{wordCount},</if>
            <if test="pageCount != null">page_count=#{pageCount},</if>
            <if test="courseName != null">course_name=#{courseName},</if>
            <if test="major != null">major=#{major},</if>
            <if test="grade != null">grade=#{grade},</if>
            <if test="textbookType != null">textbook_type=#{textbookType},</if>
            <if test="category != null">category=#{category},</if>
            <if test="description != null">description=#{description},</if>
            <if test="coverImage != null">cover_image=#{coverImage},</if>
            <if test="status != null">status=#{status},</if>
            <if test="updateBy != null">update_by=#{updateBy},</if>update_time=sysdate()
        </set>
        where book_id=#{bookId}
    </update>

    <delete id="deleteTbBookByBookId" parameterType="Long">
        update textbook_info set del_flag='1' where book_id=#{bookId}
    </delete>

    <delete id="deleteTbBookByBookIds" parameterType="String">
        update textbook_info set del_flag='1' where book_id in
        <foreach item="bookId" collection="array" open="(" separator="," close=")">#{bookId}</foreach>
    </delete>

    <select id="selectTbBookByIsbn" parameterType="String" resultMap="TbBookResult">
        <include refid="selectTbBookVo"/> where isbn = #{isbn} and del_flag = '0' limit 1
    </select>

    <select id="selectTbBookListByName" parameterType="String" resultMap="TbBookResult">
        <include refid="selectTbBookVo"/> where book_name like concat('%',#{bookName},'%') and del_flag = '0' limit 10
    </select>
</mapper>
