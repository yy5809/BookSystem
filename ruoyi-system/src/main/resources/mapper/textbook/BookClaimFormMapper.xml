<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.textbook.mapper.BookClaimFormMapper">

    <resultMap type="com.ruoyi.textbook.domain.BookClaimForm" id="BookClaimFormResult">
        <result property="formId"         column="form_id"         />
        <result property="formNo"         column="form_no"         />
        <result property="noticeId"       column="notice_id"       />
        <result property="collegeId"      column="college_id"      />
        <result property="majorId"        column="major_id"        />
        <result property="classId"        column="class_id"        />
        <result property="className"      column="class_name"      />
        <result property="status"         column="status"          />
        <result property="plannedQty"     column="planned_qty"     />
        <result property="issuedQty"      column="issued_qty"      />
        <result property="receiverName"   column="receiver_name"   />
        <result property="issueTime"      column="issue_time"      />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="delFlag"        column="del_flag"        />
        <result property="remark"         column="remark"          />
    </resultMap>

    <sql id="selectBookClaimFormVo">
        select form_id, form_no, notice_id, college_id, major_id, class_id, class_name,
               status, planned_qty, issued_qty, receiver_name, issue_time,
               create_by, create_time, update_by, update_time, remark, del_flag
        from textbook_claim_form
    </sql>

    <select id="selectBookClaimFormById" parameterType="Long" resultMap="BookClaimFormResult">
        <include refid="selectBookClaimFormVo"/>
        where form_id = #{formId} and del_flag = '0'
    </select>

    <select id="selectBookClaimFormList" parameterType="com.ruoyi.textbook.domain.BookClaimForm" resultMap="BookClaimFormResult">
        <include refid="selectBookClaimFormVo"/>
        <where>
            del_flag = '0'
            <if test="noticeId != null">and notice_id = #{noticeId}</if>
            <if test="classId != null">and class_id = #{classId}</if>
            <if test="className != null and className != ''">and class_name like concat('%', #{className}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectBookClaimFormsByNoticeId" parameterType="Long" resultMap="BookClaimFormResult">
        <include refid="selectBookClaimFormVo"/>
        where notice_id = #{noticeId} and del_flag = '0'
        order by class_name
    </select>

    <insert id="insertBookClaimForm" parameterType="com.ruoyi.textbook.domain.BookClaimForm" useGeneratedKeys="true" keyProperty="formId">
        insert into textbook_claim_form (
            <if test="formNo != null and formNo != ''">form_no,</if>
            <if test="noticeId != null">notice_id,</if>
            <if test="collegeId != null">college_id,</if>
            <if test="majorId != null">major_id,</if>
            <if test="classId != null">class_id,</if>
            <if test="className != null and className != ''">class_name,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="plannedQty != null">planned_qty,</if>
            <if test="issuedQty != null">issued_qty,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time,
            <if test="remark != null and remark != ''">remark,</if>
            del_flag
        )values(
            <if test="formNo != null and formNo != ''">#{formNo},</if>
            <if test="noticeId != null">#{noticeId},</if>
            <if test="collegeId != null">#{collegeId},</if>
            <if test="majorId != null">#{majorId},</if>
            <if test="classId != null">#{classId},</if>
            <if test="className != null and className != ''">#{className},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="plannedQty != null">#{plannedQty},</if>
            <if test="issuedQty != null">#{issuedQty},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate(),
            <if test="remark != null and remark != ''">#{remark},</if>
            '0'
        )
    </insert>

    <update id="updateBookClaimForm" parameterType="com.ruoyi.textbook.domain.BookClaimForm">
        update textbook_claim_form
        <set>
            <if test="receiverName != null and receiverName != ''">receiver_name = #{receiverName},</if>
            <if test="issueTime != null">issue_time = #{issueTime},</if>
            <if test="issuedQty != null">issued_qty = #{issuedQty},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where form_id = #{formId} and del_flag = '0'
    </update>

    <update id="updateFormStatus">
        update textbook_claim_form set status = #{status}, update_time = sysdate()
        where form_id = #{formId} and del_flag = '0'
    </update>

    <delete id="deleteBookClaimFormById" parameterType="Long">
        update textbook_claim_form set del_flag = '1' where form_id = #{formId}
    </delete>

    <delete id="deleteBookClaimFormByIds" parameterType="String">
        update textbook_claim_form set del_flag = '1' where form_id in
        <foreach item="formId" collection="array" open="(" separator="," close=")">
            #{formId}
        </foreach>
    </delete>

</mapper>
