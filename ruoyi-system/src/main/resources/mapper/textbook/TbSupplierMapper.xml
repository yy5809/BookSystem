<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.textbook.mapper.TbSupplierMapper">
    <resultMap type="com.ruoyi.textbook.domain.TbSupplier" id="TbSupplierResult">
        <id property="supplierId" column="supplier_id"/>
        <result property="supplierCode" column="supplier_code"/>
        <result property="supplierName" column="supplier_name"/>
        <result property="contactPerson" column="contact_person"/>
        <result property="contactPhone" column="contact_phone"/>
        <result property="contactEmail" column="contact_email"/>
        <result property="address" column="address"/>
        <result property="discountRate" column="discount_rate"/>
        <result property="paymentTerms" column="payment_terms"/>
        <result property="bankName" column="bank_name"/>
        <result property="bankAccount" column="bank_account"/>
        <result property="taxNumber" column="tax_number"/>
        <result property="status" column="status"/>
        <result property="delFlag" column="del_flag"/>
        <result property="userId" column="user_id"/>
    </resultMap>

    <sql id="selectTbSupplierVo">
        SELECT supplier_id, supplier_code, supplier_name, contact_person, contact_phone, contact_email, 
               address, discount_rate, payment_terms, bank_name, bank_account, tax_number, status, del_flag, user_id 
        FROM textbook_supplier 
        WHERE del_flag = '0'
    </sql>

    <select id="selectByUserId" parameterType="Long" resultMap="TbSupplierResult">
        <include refid="selectTbSupplierVo"/>
        AND user_id = #{userId}
    </select>

    <select id="selectBySupplierId" parameterType="Long" resultMap="TbSupplierResult">
        <include refid="selectTbSupplierVo"/>
        AND supplier_id = #{supplierId}
    </select>

    <insert id="insertTbSupplier" parameterType="com.ruoyi.textbook.domain.TbSupplier" useGeneratedKeys="true" keyProperty="supplierId">
        INSERT INTO textbook_supplier
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="supplierCode != null and supplierCode != ''">supplier_code,</if>
            <if test="supplierName != null and supplierName != ''">supplier_name,</if>
            <if test="contactPerson != null and contactPerson != ''">contact_person,</if>
            <if test="contactPhone != null and contactPhone != ''">contact_phone,</if>
            <if test="contactEmail != null and contactEmail != ''">contact_email,</if>
            <if test="address != null and address != ''">address,</if>
            <if test="discountRate != null">discount_rate,</if>
            <if test="paymentTerms != null and paymentTerms != ''">payment_terms,</if>
            <if test="bankName != null and bankName != ''">bank_name,</if>
            <if test="bankAccount != null and bankAccount != ''">bank_account,</if>
            <if test="taxNumber != null and taxNumber != ''">tax_number,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            <if test="userId != null">user_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="supplierCode != null and supplierCode != ''">#{supplierCode},</if>
            <if test="supplierName != null and supplierName != ''">#{supplierName},</if>
            <if test="contactPerson != null and contactPerson != ''">#{contactPerson},</if>
            <if test="contactPhone != null and contactPhone != ''">#{contactPhone},</if>
            <if test="contactEmail != null and contactEmail != ''">#{contactEmail},</if>
            <if test="address != null and address != ''">#{address},</if>
            <if test="discountRate != null">#{discountRate},</if>
            <if test="paymentTerms != null and paymentTerms != ''">#{paymentTerms},</if>
            <if test="bankName != null and bankName != ''">#{bankName},</if>
            <if test="bankAccount != null and bankAccount != ''">#{bankAccount},</if>
            <if test="taxNumber != null and taxNumber != ''">#{taxNumber},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            <if test="userId != null">#{userId},</if>
        </trim>
    </insert>

    <update id="updateTbSupplier" parameterType="com.ruoyi.textbook.domain.TbSupplier">
        UPDATE textbook_supplier
        <set>
            <if test="supplierCode != null and supplierCode != ''">supplier_code = #{supplierCode},</if>
            <if test="supplierName != null and supplierName != ''">supplier_name = #{supplierName},</if>
            <if test="contactPerson != null and contactPerson != ''">contact_person = #{contactPerson},</if>
            <if test="contactPhone != null and contactPhone != ''">contact_phone = #{contactPhone},</if>
            <if test="contactEmail != null and contactEmail != ''">contact_email = #{contactEmail},</if>
            <if test="address != null and address != ''">address = #{address},</if>
            <if test="discountRate != null">discount_rate = #{discountRate},</if>
            <if test="paymentTerms != null and paymentTerms != ''">payment_terms = #{paymentTerms},</if>
            <if test="bankName != null and bankName != ''">bank_name = #{bankName},</if>
            <if test="bankAccount != null and bankAccount != ''">bank_account = #{bankAccount},</if>
            <if test="taxNumber != null and taxNumber != ''">tax_number = #{taxNumber},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
            <if test="userId != null">user_id = #{userId},</if>
        </set>
        WHERE supplier_id = #{supplierId} AND del_flag = '0'
    </update>

    <delete id="deleteTbSupplierById" parameterType="Long">
        UPDATE textbook_supplier SET del_flag = '1' WHERE supplier_id = #{supplierId}
    </delete>

    <delete id="deleteTbSupplierByIds" parameterType="Long[]">
        UPDATE textbook_supplier SET del_flag = '1' WHERE supplier_id IN
        <foreach item="supplierId" collection="array" open="(" separator="," close=")">#{supplierId}</foreach>
    </delete>

    <select id="selectTbSupplierList" parameterType="com.ruoyi.textbook.domain.TbSupplier" resultMap="TbSupplierResult">
        <include refid="selectTbSupplierVo"/>
        <if test="supplierName != null and supplierName != ''">
            AND supplier_name LIKE CONCAT('%', #{supplierName}, '%')
        </if>
        <if test="contactPerson != null and contactPerson != ''">
            AND contact_person LIKE CONCAT('%', #{contactPerson}, '%')
        </if>
        <if test="contactPhone != null and contactPhone != ''">
            AND contact_phone LIKE CONCAT('%', #{contactPhone}, '%')
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        ORDER BY supplier_id DESC
    </select>

    <select id="countPendingShipmentBySupplierId" parameterType="Long" resultType="Integer">
        SELECT COUNT(*) FROM textbook_buy 
        WHERE supplier_id = #{supplierId} 
        AND purchase_status IN ('1', '2') 
        AND del_flag = '0'
    </select>

    <select id="selectSupplierPurchases" parameterType="com.ruoyi.textbook.domain.TbPurchase" resultMap="com.ruoyi.textbook.mapper.TbPurchaseMapper.TbPurchaseResult">
        SELECT t.buy_id, t.purchase_no, t.user_id, t.user_name, t.user_type, t.dept_name, 
               t.buy_num, t.audit_status, t.audit_user_id, t.audit_time, 
               t.reject_reason, t.audit_opinion, t.receive_time, 
               t.submit_time, t.create_time, t.del_flag, t.funding_source, t.file_hash, 
               t.supplier_id, t.purchase_status, t.logistics_no, t.logistics_company, t.invoice_no
        FROM textbook_buy t 
        WHERE t.del_flag = '0' 
        AND t.supplier_id = #{supplierId}
        <if test="purchaseNo != null and purchaseNo != ''">
            AND t.purchase_no LIKE CONCAT('%', #{purchaseNo}, '%')
        </if>
        <if test="purchaseStatus != null and purchaseStatus != ''">
            AND t.purchase_status = #{purchaseStatus}
        </if>
        ORDER BY t.submit_time DESC
    </select>
</mapper>
