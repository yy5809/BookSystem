<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.textbook.mapper.BookPersonalApplyMapper">

    <resultMap type="com.ruoyi.textbook.domain.BookPersonalApply" id="BookPersonalApplyResult">
        <result property="applyId"    column="apply_id"    />
        <result property="applyNo"    column="apply_no"    />
        <result property="teacherId"  column="teacher_id"  />
        <result property="teacherName"  column="teacher_name"  />
        <result property="textbookId"  column="textbook_id"  />
        <result property="isbn"       column="isbn"       />
        <result property="bookName"   column="book_name"   />
        <result property="applyQty"   column="apply_qty"   />
        <result property="purpose"    column="purpose"     />
        <result property="status"     column="status"      />
        <result property="auditOpinion" column="audit_opinion" />
        <result property="auditBy"    column="audit_by"    />
        <result property="auditTime"  column="audit_time"  />
        <result property="issueTime"  column="issue_time"  />
        <result property="receivedTime"  column="received_time"  />
        <result property="receiveOperator"  column="receive_operator"  />
        <result property="receiveLocation"  column="receive_location"  />
        <result property="shortageStatus" column="shortage_status"/>
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by"   />
        <result property="updateTime" column="update_time" />
        <result property="delFlag"    column="del_flag"    />
        <result property="remark"     column="remark"      />
    </resultMap>

    <sql id="selectBookPersonalApplyVo">
        select pa.apply_id, pa.apply_no, pa.teacher_id, pa.teacher_name, pa.textbook_id, pa.isbn, pa.book_name, pa.apply_qty, pa.purpose,
               pa.status, pa.audit_opinion, pa.audit_by, pa.audit_time, pa.issue_time, pa.received_time, pa.receive_operator, pa.receive_location,
               (select max(l.handle_status) from textbook_lack l
                where l.source in ('1','3') and l.source_id = pa.apply_id and l.del_flag = '0') as shortage_status,
               pa.create_by, pa.create_time, pa.update_by, pa.update_time,
               pa.del_flag, pa.remark
        from textbook_personal_apply pa
    </sql>

    <select id="selectBookPersonalApplyList" parameterType="com.ruoyi.textbook.domain.BookPersonalApply" resultMap="BookPersonalApplyResult">
        <include refid="selectBookPersonalApplyVo"/>
        <where>
            pa.del_flag = '0'
            <if test="applyNo != null and applyNo != ''"> AND pa.apply_no like concat('%', #{applyNo}, '%')</if>
            <if test="teacherName != null and teacherName != ''"> AND pa.teacher_name like concat('%', #{teacherName}, '%')</if>
            <if test="isbn != null and isbn != ''"> AND pa.isbn like concat('%', #{isbn}, '%')</if>
            <if test="bookName != null and bookName != ''"> AND pa.book_name like concat('%', #{bookName}, '%')</if>
            <if test="status != null and status != ''"> AND pa.status = #{status}</if>
            <if test="params.beginTime != null and params.beginTime != ''"> AND date_format(pa.create_time,'%y%m%d') &gt;= date_format(#{params.beginTime},'%y%m%d')</if>
            <if test="params.endTime != null and params.endTime != ''"> AND date_format(pa.create_time,'%y%m%d') &lt;= date_format(#{params.endTime},'%y%m%d')</if>
            ${params.dataScope}
        </where>
        order by pa.create_time desc
    </select>

    <select id="selectMyApplyList" parameterType="com.ruoyi.textbook.domain.BookPersonalApply" resultMap="BookPersonalApplyResult">
        <include refid="selectBookPersonalApplyVo"/>
        <where>
            pa.del_flag = '0' AND pa.teacher_id = #{teacherId}
            <if test="status != null and status != ''"> AND pa.status = #{status}</if>
            <if test="params.beginTime != null and params.beginTime != ''"> AND date_format(pa.create_time,'%y%m%d') &gt;= date_format(#{params.beginTime},'%y%m%d')</if>
            <if test="params.endTime != null and params.endTime != ''"> AND date_format(pa.create_time,'%y%m%d') &lt;= date_format(#{params.endTime},'%y%m%d')</if>
        </where>
        order by pa.create_time desc
    </select>

    <select id="selectBookPersonalApplyById" parameterType="Long" resultMap="BookPersonalApplyResult">
        <include refid="selectBookPersonalApplyVo"/>
        where pa.apply_id = #{applyId} and pa.del_flag = '0'
    </select>

    <select id="selectBookPersonalApplyByIds" parameterType="java.util.List" resultMap="BookPersonalApplyResult">
        <include refid="selectBookPersonalApplyVo"/>
        where pa.apply_id in
        <foreach item="applyId" collection="list" open="(" separator="," close=")">#{applyId}</foreach>
        and pa.del_flag = '0'
    </select>

    <insert id="insertBookPersonalApply" parameterType="com.ruoyi.textbook.domain.BookPersonalApply" useGeneratedKeys="true" keyProperty="applyId">
        insert into textbook_personal_apply (
            <if test="applyNo != null and applyNo != ''">apply_no,</if>
            <if test="teacherId != null">teacher_id,</if>
            <if test="teacherName != null and teacherName != ''">teacher_name,</if>
            <if test="textbookId != null">textbook_id,</if>
            <if test="isbn != null">isbn,</if>
            <if test="bookName != null and bookName != ''">book_name,</if>
            <if test="applyQty != null">apply_qty,</if>
            <if test="purpose != null">purpose,</if>
            status,
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="applyNo != null and applyNo != ''">#{applyNo},</if>
            <if test="teacherId != null">#{teacherId},</if>
            <if test="teacherName != null and teacherName != ''">#{teacherName},</if>
            <if test="textbookId != null">#{textbookId},</if>
            <if test="isbn != null">#{isbn},</if>
            <if test="bookName != null and bookName != ''">#{bookName},</if>
            <if test="applyQty != null">#{applyQty},</if>
            <if test="purpose != null">#{purpose},</if>
            '0',
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateBookPersonalApply" parameterType="com.ruoyi.textbook.domain.BookPersonalApply">
        update textbook_personal_apply
        <set>
            <if test="auditOpinion != null">audit_opinion = #{auditOpinion},</if>
            <if test="auditBy != null and auditBy != ''">audit_by = #{auditBy},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="issueTime != null">issue_time = #{issueTime},</if>
            <if test="receivedTime != null">received_time = #{receivedTime},</if>
            <if test="receiveOperator != null">receive_operator = #{receiveOperator},</if>
            <if test="receiveLocation != null">receive_location = #{receiveLocation},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where apply_id = #{applyId} and del_flag = '0'
    </update>

    <update id="restoreToApproved">
        UPDATE textbook_personal_apply
        SET status = '1', audit_opinion = #{auditOpinion}, update_by = #{updateBy}, update_time = #{updateTime}
        WHERE apply_id = #{applyId} AND del_flag = '0'
    </update>

    <delete id="deleteBookPersonalApplyByIds" parameterType="String">
        update textbook_personal_apply set del_flag = '1' where apply_id in
        <foreach item="applyId" collection="array" open="(" separator="," close=")">
            #{applyId}
        </foreach>
    </delete>

    <delete id="deleteBookPersonalApplyById" parameterType="Long">
        update textbook_personal_apply set del_flag = '1' where apply_id = #{applyId}
    </delete>

</mapper>
